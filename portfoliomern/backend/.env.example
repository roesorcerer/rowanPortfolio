NODE_ENV=development
PORT=5000

# MongoDB connection string
# Local: mongodb://localhost:27017/portfolio
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/portfolio
MONGODB_URI=

# Frontend origin for CORS
CORS_ORIGIN=http://localhost:3000

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Contact form / SMTP ---
# The inbox that receives contact submissions.
CONTACT_EMAIL=

# SMTP transport used by nodemailer.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#        SMTP_USER=<your-gmail>, SMTP_PASSWORD=<app-password> (NOT your account password)
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_SECURE=false,
#        SMTP_USER=apikey, SMTP_PASSWORD=<sendgrid-api-key>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional: override the From header (defaults to SMTP_USER).
SMTP_FROM=
