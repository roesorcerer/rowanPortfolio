+  truck: ['................', '................', '..#########.....', '..#+++++++#.....', '..#+++++++#####.', '..#+++++++#.+.#.', '..#+++++++#...#.', '..#+++++++#####.', '..#############.', '..#############.', '...###....###...', '..#...#..#...#..', '..#.+.#..#.+.#..', '...###....###...'],
+  press: ['....########....', '....#......#....', '....#.####.#....', '....#......#....', '..############..', '.#............#.', '.#.++.....###.#.', '.#............#.', '.##############.', '.#.+.+.+.+.+.+#.', '.##############.', '...#........#...', '...#.######.#...', '...#........#...', '...##########...'],
+  storm: ['................', '.....####.......', '...##....##.##..', '..#........#..#.', '.#.............#', '.#.............#', '..#############.', '.......++.......', '......++........', '.....+++++......', '........++......', '.......++.......', '......++........', '..#......#....#.', '.#......#....#..'],
