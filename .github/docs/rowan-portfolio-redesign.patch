+  result: string;
+  links: Link[];
+  notes?: Partial<Record<RoleKey, string>>;
+  /** Finds the project whose case study this chapter links to. */
+  study?: RegExp;
+  lost?: boolean;
+  win?: boolean;
+  end?: boolean;
+}
+
+export interface Place {
