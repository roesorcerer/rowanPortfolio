+@import "@fontsource/vt323/400.css";
+@import "@fontsource/ibm-plex-mono/400.css";
+@import "@fontsource/ibm-plex-mono/600.css";
+@import "@fontsource/ibm-plex-sans/400.css";
+@import "@fontsource/ibm-plex-sans/600.css";
+
+/* The public site. `--c-*` are the channels behind the Tailwind tokens, so the
+   case study components follow the theme without knowing it exists. `--p`,
+   `--bg` and `--you` are the same palette for the hand-written classes here. */
+
+:root[data-theme="dark"] {
+  --p: #4bff8a;
+  --bg: #030503;
+  --you: #ffc24b;
+  --todo: #ffffff;
+  --hatch: rgba(75, 255, 138, .2);
+  --glow: rgba(75, 255, 138, .5);
+
+  --c-ink: 75 255 138;
+  --c-ink-deep: 3 5 3;
+  --c-paper: 3 5 3;
+  --c-surface: 9 18 12;
+  --c-body: 205 242 219;
+  --c-muted: 160 222 182;
+  --c-faint: 130 200 156;
+  --c-rule: 38 120 72;
+  --c-rule-soft: 26 80 50;
+  --c-accent: 75 255 138;
+  --c-accent-dark: 255 194 75;
+  --c-accent-darker: 255 218 150;
+  --c-accent-soft: 16 44 28;
+  --c-danger: 255 150 130;
+}
+
+:root[data-theme="light"] {
+  --p: #10352b;
+  --bg: #edf3ee;
+  --you: #b23a12;
+  --todo: #b23a12;
+  --hatch: rgba(16, 53, 43, .18);
+  --glow: transparent;
+
+  --c-ink: 16 53 43;
+  --c-ink-deep: 10 36 29;
+  --c-paper: 237 243 238;
+  --c-surface: 247 250 247;
+  --c-body: 28 68 57;
+  --c-muted: 50 88 76;
+  --c-faint: 62 100 88;
+  --c-rule: 150 178 163;
+  --c-rule-soft: 200 216 206;
+  --c-accent: 16 53 43;
+  --c-accent-dark: 166 52 14;
+  --c-accent-darker: 130 40 10;
+  --c-accent-soft: 219 231 223;
+  --c-danger: 165 36 28;
+}
+
+:root[data-theme] body { background-color: var(--bg); }
+
+.site {
+  --font-display: "VT323", ui-monospace, Menlo, monospace;
+  --font-text: "IBM Plex Mono", ui-monospace, Menlo, monospace;
+  --font-long: "IBM Plex Sans", system-ui, sans-serif;
+  position: relative;
+  min-height: 100vh;
+  padding: clamp(10px, 2.5vw, 24px);
+  display: flex;
+  justify-content: center;
+  background-color: var(--bg);
+  color: var(--p);
+  font-family: var(--font-text);
+  font-size: clamp(16px, .35vw + 15px, 18px);
+  line-height: 1.6;
+}
+
+.site h1, .site h2, .site h3, .site h4 { font-family: var(--font-display); font-weight: 400 !important; }
+.site a, .site button, .site input, .site textarea, .site label { font-family: inherit; }
+.site a { text-underline-offset: 3px; }
+.site-page { position: relative; z-index: 1; width: 100%; max-width: 1040px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
+.site main:focus { outline: none; }
+
+.d { font-family: var(--font-display); font-weight: 400; }
+.crt .d { text-shadow: 0 0 12px var(--glow); }
+
+/* Pointer light on dark, graph paper on light. Long reads get neither. */
+.torch { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
+.crt .torch {
+  background-image: linear-gradient(var(--p) 1px, transparent 1px), linear-gradient(90deg, var(--p) 1px, transparent 1px);
+  background-size: 32px 32px;
+  opacity: .16;
+  -webkit-mask-image: radial-gradient(240px circle at var(--mx, -999px) var(--my, -999px), #000, transparent);
+  mask-image: radial-gradient(240px circle at var(--mx, -999px) var(--my, -999px), #000, transparent);
+}
+.crt .scan { position: fixed; inset: 0; pointer-events: none; z-index: 3; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, .09) 0 1px, transparent 1px 3px); }
+.paper {
+  background-image: linear-gradient(rgba(40, 90, 120, .17) 1px, transparent 1px), linear-gradient(90deg, rgba(40, 90, 120, .17) 1px, transparent 1px);
+  background-size: 24px 24px;
+}
+.reading .torch, .reading .scan { display: none; }
+.reading.paper { background-image: none; }
+
+.skip { position: absolute; left: 12px; top: -60px; z-index: 6; background: var(--p); color: var(--bg); padding: 8px 12px; }
+.skip:focus { top: 12px; }
+
+.topbar { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; justify-content: space-between; }
+.topbar-name { font-size: 26px; color: var(--p); text-decoration: none; letter-spacing: 1px; }
+.nav { display: flex; flex-wrap: wrap; gap: 4px 16px; }
+.nav a, .link { color: var(--p); text-decoration: underline; }
+.nav a:hover, .link:hover { color: var(--you); }
+.site a:focus-visible, .site button:focus-visible { outline: 3px solid var(--you); outline-offset: 2px; }
+
+/* Buttons */
+.site .cmd {
+  font-family: var(--font-display); font-size: 22px; line-height: 1.1; color: var(--p);
+  background: var(--bg); border: 2px solid var(--p); padding: 8px 12px; min-height: 44px;
+  cursor: pointer; text-align: left; text-decoration: none; display: flex; align-items: center;
+  gap: 8px; letter-spacing: .5px;
+}
+.site .cmd.primary { background: var(--p); color: var(--bg); }
+.site .cmd:hover { background: var(--p); color: var(--bg); }
+.site .cmd:disabled { opacity: .6; cursor: default; }
+
+/* Sections */
+.stack-page { display: flex; flex-direction: column; gap: 16px; }
+.stack { display: flex; flex-direction: column; gap: 14px; }
+.actions { display: flex; flex-wrap: wrap; gap: 10px; }
+.sec { border: 2px solid var(--p); background-color: var(--bg); scroll-margin-top: 12px; }
+.sec-body { padding: 18px 16px; }
+.strip { background: var(--p); color: var(--bg); padding: 4px 12px; font-size: 26px; letter-spacing: 1.5px; text-shadow: none !important; }
+.lead { max-width: 60ch; }
+
+.hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); overflow: hidden; }
+.hero-text { padding: clamp(20px, 4vw, 40px); display: flex; flex-direction: column; gap: 14px; align-items: flex-start; min-width: 0; }
+.hero-kicker { font-weight: 600; }
+.hero-name { font-size: clamp(60px, 9.4vw, 108px); line-height: .86; letter-spacing: 1px; }
+.hero-name span { display: block; }
+.hero-lede { font-size: clamp(17px, 2vw, 20px); }
+canvas.hero-view { display: block; width: 100%; height: 100%; min-height: 320px; border-left: 2px solid var(--p); }
+
+.facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px 24px; }
+.facts dt { font-weight: 600; }
+.facts dd { margin-top: 2px; }
+
+/* Work */
+.tabs, .skills { display: flex; flex-wrap: wrap; gap: 8px; }
+.skills { gap: 6px; }
+.tab { font-family: var(--font-display); font-size: 22px; color: var(--p); background: transparent; border: 2px solid var(--p); padding: 4px 12px; min-height: 44px; cursor: pointer; }
+.tab.on, .tab:hover, .skill.on, .skill:hover { background: var(--p); color: var(--bg); }
+.skill { font: inherit; font-size: 15px; color: var(--p); background: transparent; border: 1px solid var(--p); padding: 4px 9px; min-height: 32px; cursor: pointer; }
+.site .plain-h { font-family: inherit; font-size: 1em; font-weight: 600 !important; margin-bottom: 6px; }
+.work-status { font-weight: 600; }
+.work-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
+.work-card { border: 2px solid var(--p); display: flex; flex-direction: column; min-width: 0; background: var(--bg); }
+.thumb { height: 170px; display: flex; align-items: center; justify-content: center; border-bottom: 2px solid var(--p); background-image: repeating-linear-gradient(45deg, var(--hatch) 0 2px, transparent 2px 9px); overflow: hidden; }
+.thumb img { display: block; max-width: 100%; max-height: 100%; object-fit: contain; }
+.card-sprite { display: block; width: 72px; height: 72px; }
+.work-body { padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; flex: 1 1 auto; }
+.work-title { font-size: 28px; line-height: 1; }
+.work-title a { color: inherit; text-decoration: none; }
+.work-title a:hover { color: var(--you); }
+.work-note { font-weight: 600; }
+.work-text { flex: 1 1 auto; }
+.work-tags { font-size: 15px; }
+.work-links { display: flex; flex-wrap: wrap; gap: 4px 16px; }
+
+/* The long way down */
+.stairs { position: relative; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); align-items: end; height: clamp(200px, 27vw, 270px); margin-top: 8px; }
+.stair { font-family: var(--font-display); font-size: 22px; color: var(--p); background-color: var(--bg); background-image: repeating-linear-gradient(45deg, var(--hatch) 0 2px, transparent 2px 9px); border: 2px solid var(--p); margin-left: -2px; padding: 6px 0 0; cursor: pointer; display: flex; justify-content: center; align-items: flex-start; min-width: 0; transition: background .12s; }
+.stair.on, .stair:hover { background-color: var(--p); background-image: none; color: var(--bg); }
+.site .stair:focus-visible { outline-offset: -5px; }
+.pawn { position: absolute; width: 30px; height: 30px; transform: translateX(-50%); transition: left .4s steps(7), bottom .4s steps(7); pointer-events: none; }
+.stair-detail { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: flex-end; justify-content: space-between; }
+.stair-copy { flex: 1 1 320px; max-width: 60ch; }
+.stair-name { font-size: 30px; }
+.stair-when { font-size: 15px; }
+.stair-copy p:last-child { margin-top: 6px; }
+
+/* Contact */
+.contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px 28px; }
+.contact-form { position: relative; display: flex; flex-direction: column; gap: 12px; min-width: 0; align-items: stretch; }
+.contact-form .cmd { align-self: flex-start; }
+.contact-aside { align-items: flex-start; }
+.field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
+.field input, .field textarea { font: inherit; color: var(--p); background: var(--bg); border: 2px solid var(--p); padding: 9px 10px; min-height: 44px; width: 100%; }
+.field input:focus-visible, .field textarea:focus-visible { outline: 3px solid var(--you); outline-offset: 1px; }
+.honeypot { position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }
+.form-error { color: rgb(var(--c-danger)); font-weight: 600; }
+
+/* A project page: a long read, so a quieter face and a solid sheet. */
+.doc { background-color: var(--bg); border: 2px solid var(--p); font-family: var(--font-long); }
+.doc .doc-back { font-family: var(--font-text); }
+.site .doc h1 { font-size: clamp(38px, 6vw, 58px); line-height: 1; }
+.site .doc h2 { font-size: 28px; text-transform: none; letter-spacing: .5px; }
+.site .doc h3 { font-size: 24px; line-height: 1.15; text-transform: none; letter-spacing: .3px; }
+.site .doc figcaption { color: rgb(var(--c-muted)); }
+/* Thesis figures are drawn on white; the backing stays the size of the image. */
+.site .doc figure img { background: #fff; width: auto; max-width: 100%; margin-inline: auto; }
+.doc-status { padding: 96px 16px; text-align: center; color: rgb(var(--c-muted)); }
+
+@media (max-width: 640px) {
+  .site .cmd { font-size: 20px; }
+  .strip { font-size: 23px; }
+  .sec-body { padding: 14px 12px; }
+  .hero { grid-template-columns: minmax(0, 1fr); }
+  canvas.hero-view { min-height: 190px; height: 190px; border-left: 0; border-top: 2px solid var(--p); order: 2; }
+  .stair { font-size: 18px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .site *, .site *::before, .site *::after { animation: none !important; transition: none !important; }
+}
+
+@media print {
+  .torch, .scan, .topbar { display: none; }
+}
diff --git a/frontend/src/site/theme.tsx b/frontend/src/site/theme.tsx
new file mode 100644
index 0000000..e882da9
--- /dev/null
+++ b/frontend/src/site/theme.tsx
@@ -0,0 +1,68 @@
+import { createContext, useCallback, useContext, useEffect, useState, type ReactNode } from "react";
+
+// Light and dark for the public pages. The admin and the resume stay as they
+// are: the theme only exists while a page inside SiteShell is mounted, because
+// the tokens in site.css hang off <html data-theme>.
+
+export type Theme = "light" | "dark";
+
+const STORAGE_KEY = "portfolio-theme";
+
+function initialTheme(): Theme {
+  try {
+    const stored = window.localStorage.getItem(STORAGE_KEY);
+    if (stored === "light" || stored === "dark") return stored;
+    return window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
+  } catch {
+    return "dark";
+  }
+}
+
+const ThemeContext = createContext<{ theme: Theme; toggleTheme: () => void }>({
+  theme: "dark",
+  toggleTheme: () => {},
+});
+
+export function ThemeProvider({ children }: { children: ReactNode }) {
+  const [theme, setTheme] = useState<Theme>(initialTheme);
+
+  useEffect(() => {
+    const root = document.documentElement;
+    root.dataset.theme = theme;
+    return () => {
+      delete root.dataset.theme;
+    };
+  }, [theme]);
+
+  const toggleTheme = useCallback(() => {
+    setTheme((current) => {
+      const next = current === "light" ? "dark" : "light";
+      try {
+        window.localStorage.setItem(STORAGE_KEY, next);
+      } catch {
+        // The choice just won't be remembered.
+      }
+      return next;
+    });
+  }, []);
+
+  return (
+    <ThemeContext.Provider value={{ theme, toggleTheme }}>{children}</ThemeContext.Provider>
+  );
+}
+
+export const useTheme = () => useContext(ThemeContext);
+
+export function ThemeToggle() {
+  const { theme, toggleTheme } = useTheme();
+  return (
+    <button
+      className="cmd"
+      type="button"
+      aria-pressed={theme === "light"}
+      onClick={toggleTheme}
+    >
+      {theme === "light" ? "Dark mode" : "Light mode"}
+    </button>
+  );
+}
