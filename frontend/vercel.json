{
  "buildCommand": "npm run build:site",
  "outputDirectory": "build",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rowan-portfolio-api.fly.dev/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/play",
      "destination": "/app.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/app.html"
    }
  ]
}
